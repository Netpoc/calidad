# Copy to .env and fill in.
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/calidad
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# First-boot bootstrap (for hosts with no shell, e.g. Render free tier): when
# the database has no users and both are set, this platform admin is created on
# startup. The platform admin creates businesses from the app; it has no
# business of its own.
# PLATFORM_ADMIN_EMAIL=you@yourdomain.com
# PLATFORM_ADMIN_PASSWORD=a-strong-password

# SMS driver: "log" writes messages to stdout (default in development).
# Swap for a real provider by adding a driver in src/modules/notifications/drivers.
SMS_DRIVER=log
SMS_SENDER_ID=Calidad
