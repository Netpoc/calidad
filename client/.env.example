# Copy to .env.local (gitignored) to override.

# Where `npm run dev` proxies /api. Default: the local server on :4000.
# Point at Render to develop against the live backend:
# VITE_DEV_PROXY_TARGET=https://calidad-tthd.onrender.com

# Production API base. Leave unset on Netlify — netlify.toml proxies /api to
# Render so the app stays same-origin. Set only if calling the API directly:
# VITE_API_URL=https://calidad-tthd.onrender.com/api
